APP_BIND_ADDRESS=0.0.0.0
APP_PORT=80
IMAGE_TAG=latest
BASIC_AUTH_FILE=./.secrets/htpasswd

POSTGRES_DB=hype_radar
POSTGRES_USER=hype_radar
POSTGRES_PASSWORD=replace-with-a-url-safe-password
DATABASE_URL=postgresql+psycopg://hype_radar:replace-with-a-url-safe-password@postgres:5432/hype_radar
DATABASE_ECHO=false

HYPERLIQUID_NETWORK=mainnet

OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1
OPENROUTER_TRANSCRIPTION_API_URL=https://openrouter.ai/api/v1/audio/transcriptions
OPENROUTER_TRANSCRIPTION_LANGUAGE=
OPENROUTER_SITE_URL=https://replace-with-distribution-domain.cloudfront.net
OPENROUTER_APP_NAME=Hype Radar
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_COMPLETION_TOKENS=4096
OPENROUTER_MAX_AUDIO_BYTES=10485760
