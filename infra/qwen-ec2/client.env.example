# Actual values are generated privately at .state/client.env by ec2.py tunnel.
# Existing Hype Radar settings; no app source edits are necessary.
OPENROUTER_API_KEY=replace-with-generated-vllm-key
OPENROUTER_MODEL=qwen3.5-9b
OPENROUTER_API_URL=http://127.0.0.1:8001/v1/chat/completions
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_COMPLETION_TOKENS=2048

# For standalone OpenAI-compatible clients.
OPENAI_API_KEY=replace-with-generated-vllm-key
OPENAI_BASE_URL=http://127.0.0.1:8001/v1
OPENAI_MODEL=qwen3.5-9b
